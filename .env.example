# Copy on the server:
#   cp .env.example .env.staging
#   cp .env.example .env.production
# Do not commit real .env.staging / .env.production files.
#
# Frontend URLs:
#   staging:    http://SERVER_IP:4000
#   production: http://SERVER_IP:4001

NEXT_PUBLIC_HOST_API=http://SERVER_IP:3000
NEXT_PUBLIC_ASSETS_API=http://SERVER_IP:3000

# Local self-signed HTTPS API only: npm run setup:local-https, then add this
# to .env.local. npm run dev loads it before starting the Next.js process.
# NODE_EXTRA_CA_CERTS=.certs/api-localhost.pem
